# ════════════════════════════════════════════════════════════════
# X GYM Mahipalpur — environment config
# Copy this file to ".env" (same folder as app.py) and fill in the
# real values below. NEVER commit the real ".env" to git — it's
# already excluded in .gitignore.
# ════════════════════════════════════════════════════════════════

# ── Admin panel login ──────────────────────────────────────────
# >>> FILL THIS IN <<< Pick your own password — do NOT keep the old
# default (11223344). This replaces the password that used to be
# hardcoded in plain text inside xgym-admin.html.
ADMIN_PASSWORD=change-this-to-a-real-password

# >>> FILL THIS IN <<< Any long random string — used to sign the
# admin's login session cookie. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# ── Meta WhatsApp Cloud API ────────────────────────────────────
# >>> FILL THESE IN <<< from your Meta for Developers app
# (developers.facebook.com -> your app -> WhatsApp -> API Setup).
# Without these, the app runs fine but "Send Reminder" /
# "Broadcast" buttons will fail with a clear error instead of
# actually sending a WhatsApp message.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# >>> FILL THIS IN (or leave as-is if you keep the same name) <<<
# Must exactly match an APPROVED template name in Meta's Template
# Builder — this is the one used for automatic expiry reminders.
META_TEMPLATE_NAME=gym_membership_reminder

# ── Daily auto-reminder cron job ───────────────────────────────
# >>> FILL THIS IN <<< Any secret string of your choosing. Whatever
# service you use to trigger /api/reminders/check-tomorrow once a
# day (cron-job.org, GitHub Actions, Render Cron, etc.) must send
# this exact value in the "X-CRON-SECRET" header, or the request
# is rejected.
CRON_SECRET=change-this-to-a-secret-of-your-choosing

# ── Optional: extra PIN for the Revenue page ───────────────────
# If set, the Revenue page (and editing/deleting payments) asks for
# this PIN on top of the admin login — so front-desk staff can use
# Members while only you can see the money. Leave EMPTY for no lock.
REVENUE_PIN=

# ── Optional: where the database file lives ────────────────────
# Default is xgym.db next to app.py. On a host with a persistent
# disk, point this at it (e.g. /var/data/xgym.db) so redeploys
# don't wipe your members and payments.
# DB_PATH=/var/data/xgym.db

# ── Optional: set to 1 once the site is served over https ──────
# SESSION_COOKIE_SECURE=1
